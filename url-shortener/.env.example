# Copy to .env and edit.
#
# compose.yaml and the Makefile read only MONGO_HOST_PORT from .env. The
# SHORTENER_* variables configure the CLI itself, which never reads .env: export
# them in the shell that runs url-shortener, for example with
#
#   set -a; . ./.env; set +a
#
# Every line below shows the default (see README, "Configuration").

# Host port MongoDB is published on (127.0.0.1 only). If you change it, point the
# CLI at it with SHORTENER_MONGO_URI=mongodb://localhost:<port>.
MONGO_HOST_PORT=27017

SHORTENER_MONGO_URI=mongodb://localhost:27017
SHORTENER_MONGO_DATABASE=url_shortener
SHORTENER_MONGO_TIMEOUT_MS=3000
SHORTENER_BASE_URL=https://myurlshortener.com
SHORTENER_TTL_SECONDS=3600
SHORTENER_CODE_LENGTH=7
SHORTENER_EXPIRED_RETENTION_SECONDS=86400
